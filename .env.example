SECRET_KEY=replace-with-a-strong-random-secret-key
SQLALCHEMY_DATABASE_URI=sqlite:///database/siem_ids.db
WTF_CSRF_ENABLED=true
SESSION_LIFETIME_MINUTES=30
LOGIN_RATE_LIMIT=5 per minute
RATELIMIT_STORAGE_URI=memory://
FAILED_LOGIN_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
HIGH_RISK_ALERT_THRESHOLD=0.75
MEDIUM_RISK_ALERT_THRESHOLD=0.45
SESSION_COOKIE_SECURE=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address
MAIL_PASSWORD=your-gmail-app-password
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=your-gmail-address
APP_BASE_URL=http://127.0.0.1:5000
PASSWORD_RESET_MINUTES=30
LOG_TO_CONSOLE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
